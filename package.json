{
  "name": "gembridge-analyzer",
  "version": "1.1.0",
  "description": "CCBA/GemBridge bridge tournament data ingestion, validation and analysis toolkit.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LV-ZHU/gembridge-analyzer.git"
  },
  "homepage": "https://github.com/LV-ZHU/gembridge-analyzer#readme",
  "bugs": {
    "url": "https://github.com/LV-ZHU/gembridge-analyzer/issues"
  },
  "keywords": [
    "bridge",
    "ccba",
    "gembridge",
    "contract-bridge",
    "tournament-analysis"
  ],
  "files": [
    "src/",
    "scripts/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "gembridge": "./src/cli.mjs",
    "gb": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test",
    "test:online": "node ./scripts/online-smoke.mjs",
    "verify": "npm test && npm pack --dry-run",
    "test:watch": "node --test --watch",
    "doctor": "node ./src/cli.mjs doctor",
    "board": "node ./src/cli.mjs board",
    "match": "node ./src/cli.mjs match",
    "round": "node ./src/cli.mjs round",
    "team": "node ./src/cli.mjs team",
    "player": "node ./src/cli.mjs player",
    "standings": "node ./src/cli.mjs standings",
    "butler": "node ./src/cli.mjs butler",
    "event": "node ./src/cli.mjs event",
    "setup": "npm link"
  },
  "dependencies": {
    "docx": "^9.7.1"
  }
}
